# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit a real key.
#
# Read only by scripts/fetch-market-data.mjs, which runs in the daily
# scheduled job. Keys are never bundled into the app: the browser only ever
# reads the static public/data/market.json the job produces.

# Sector data — https://finnhub.io/register (free tier, 60 req/min)
FINNHUB_API_KEY=

# Economics data — https://fredaccount.stlouisfed.org/apikeys (free)
FRED_API_KEY=
