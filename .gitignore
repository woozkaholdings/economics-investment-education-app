# Throwaway analysis scripts a dev-agent run writes while investigating and
# doesn't always clean up (e.g. scripts/.scratch-cands.mjs). They are working
# notes, not tooling — anything worth keeping belongs in a named script that
# package.json or check-data.mjs actually calls.
.scratch-*

# The two prototypes. Owner decision 2026-08-16: neither should appear in the
# project any more, and BOTH FILES STAY ON DISK — they are ignored, not
# deleted. v5 was tracked until this date and is now untracked (`git rm
# --cached`, working copy untouched); its content remains in git history.
# Neither is imported by anything under src/ — the app was rebuilt from
# scratch 2026-08-04 and they are reference inputs only (LAUNCH_PLAN.md §2.1).
# v6's one salvageable idea is preserved as AGENT_LOG.md backlog item 34.
# Do not "restore" these to the repo without asking; do not merge their
# content — v6 carries Dalio branding (§10.2) and hardcoded dates (§2.3).
economic-cycles-v5.jsx
economic-cycles-v6.jsx

# The Netlify deploy token (owner decision 2026-09-06: automate the deploy).
# It can deploy, rename and DELETE the live site, so it never enters the repo.
# scripts/deploy.mjs reads NETLIFY_AUTH_TOKEN or this file, and REFUSES to run
# at all if this path is ever actually tracked by git — an ignored secret that
# someone `git add -f`s is still a secret in history for good.
.netlify-token
